# Copy this file to .env at the repository root. Never commit .env.
# M2 Claude API (backend/app/m2). Model IDs must be exact; there is no silent substitute.
ANTHROPIC_API_KEY=
SONNET_MODEL=claude-sonnet-5-5
OPUS_MODEL=claude-opus-5-5
# Optional: where generated apps are written (must be outside this repository).
HARNESS_WORKSPACE_ROOT=
# Web M2 run budgets in USD (empty uses 0.5 / 8 / 1.5). Checked before each paid call; not a billing cap.
M2_PRD_BUDGET_USD=
M2_RUN_BUDGET_USD=
M2_TASK_BUDGET_USD=

# Requirement loop provider. claude: Sonnet via ANTHROPIC_API_KEY (M2 path).
# mock: no API calls; snowchat: legacy M1 Gateway analysis.
LLM_PROVIDER=snowchat

# Personal SnowChat API Gateway key. Backend only.
FACTCHAT_API_KEY=

# Optional override. Empty uses https://factchat-cloud.mindlogic.ai/v1/gateway
SNOWCHAT_BASE_URL=

# Empty selects gpt-5.6-luna ONLY if returned by /models/.
# To override, use an exact model ID returned by your account's /models/.
SNOWCHAT_EXTRACTION_MODEL=
SNOWCHAT_GAP_MODEL=

# Optional: low / medium / high. Empty uses model defaults.
SNOWCHAT_EXTRACTION_REASONING=
SNOWCHAT_GAP_REASONING=
